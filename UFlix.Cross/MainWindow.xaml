<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="UFlix.Cross.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Activated="Window_Activated"
        Title="UFlix"
        xmlns:tm="using:UFlix.Cross.Templates"
        xmlns:pages="using:UFlix.Cross.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Grid>
        <NavigationView PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        IsSettingsVisible="False"
                        BackRequested="NavView_BackRequested"
                        IsBackEnabled="{Binding ElementName=MFrame, Path=CanGoBack}"
                        ItemInvoked="NavView_ItemInvoked"
                        x:Name="NavView">
            <NavigationView.MenuItems>
                <tm:CustomNavItem Content="Home"
                                  IsSelected="True"
                                  PageType="pages:HomePage"
                                  Icon="Home" />
                <tm:CustomNavItem Content="Discover"
                                  PageType="pages:DiscoverPage"
                                  Icon="Globe" />
                <tm:CustomNavItem Content="Youtube"
                                  PageType="pages:YoutubePage"
                                  Icon="Video" />
                <tm:CustomNavItem Content="Live TV"
                                  PageType="pages:TvPage"
                                  Icon="WebCam" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <tm:CustomNavItem Icon="OpenFile"
                                  PageType="pages:OpenFileDialog"
                                  Content="Open" />
                <tm:CustomNavItem Icon="Download"
                                  Content="Download"
                                  PageType="pages:DownloaderDialog" />
                <tm:CustomNavItem Icon="Sync"
                                  Content="Torrents"
                                  PageType="pages:TorrentsDialog" />
                <tm:CustomNavItem Icon="Setting"
                                  Content="Settings"
                                  PageType="pages:SettingsDialog" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="MFrame" Navigated="MFrame_Navigated" />
        </NavigationView>
        <ContentControl HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed"
                        x:Name="PlayerView" />
        <tm:IAPNotification HorizontalAlignment="Right"
                            x:Name="IAP"
                            VerticalAlignment="Bottom" />
    </Grid>
</Window>
