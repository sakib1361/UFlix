<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="UFlix.Cross.Templates.HorizontalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UFlix.Cross.Templates"
             xmlns:tm="using:UFlix.Cross.Templates"
             xmlns:models="using:UFlix.Engine.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid VerticalAlignment="Top"
          Margin="10,10,0,0"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="360" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"
                    Margin="30,0"
                    VerticalAlignment="Center">
            <TextBlock FontSize="25"
                       FontWeight="SemiBold"
                       x:Name="ContentBox" />
            <TextBlock FontSize="25"
                       Margin="10,0"
                       FontWeight="SemiBold"
                       Text="-" />
            <TextBlock FontSize="25"
                       FontWeight="SemiBold"
                       x:Name="NameBox" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <Button Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Explore"
                    x:Name="ExploreButton"
                    Click="ExploreButton_Click"
                    FontSize="16"
                    Foreground="Gray" />
            <Button Opacity="0.5"
                    BorderBrush="Transparent"
                    Background="Transparent"
                    Click="LeftButton_Click">
                <SymbolIcon Symbol="Back" />
            </Button>
            <Button Opacity="0.5"
                    BorderBrush="Transparent"
                    Click="RightButton_Click"
                    Background="Transparent">
                <SymbolIcon Symbol="Forward" />
            </Button>
        </StackPanel>
        <ListView x:Name="MList"
                  Grid.Row="1"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="MList_ItemClick"
                  HorizontalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.IsHorizontalRailEnabled="False"
                  ScrollViewer.HorizontalScrollMode="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                    <StackPanel PointerEntered="StackPanel_PointerEntered"
                                PointerExited="StackPanel_PointerExited"
                                HorizontalAlignment="Left"
                                Width="180">
                        <Grid>
                            <tm:CustomImage DecodeWidth="180"
                                            Source="{x:Bind BackdropPath}"
                                            Height="280"
                                            Opacity="0.2"
                                            Visibility="{Binding ContentType, Converter={StaticResource ParamConverter},ConverterParameter=Youtube}"
                                            Stretch="Fill" />
                            <tm:CustomImage DecodeWidth="180"
                                            Source="{x:Bind Image}"
                                            Stretch="Uniform"
                                            VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="Del_Click"
                                    Opacity="0"
                                    Foreground="Maroon"
                                    x:Name="DelButton"
                                    Tag="DelButton">
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{x:Bind Title}"
                                   MaxLines="2"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Height="45"
                                   TextWrapping="Wrap" />
                        <TextBlock Opacity="0.7"
                                   HorizontalAlignment="Left"
                                   Text="{x:Bind Year}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
