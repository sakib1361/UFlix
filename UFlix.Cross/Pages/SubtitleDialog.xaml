<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="UFlix.Cross.Pages.SubtitleDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Width="900"
               Height="600"
               MaxWidth="2000"
               MaxHeight="2000"
               xmlns:models="using:UFlix.Engine.Models"
               Title="{x:Bind Movie.Title}"
               CloseButtonText="Close"
               Loaded="ContentDialog_Loaded"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d">
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">5,5,5,5</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">2000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">2000</x:Double>
    </ContentDialog.Resources>
    <Grid>
        <ListView ItemsSource="{x:Bind Subtitles}"
                  Width="500"
                  Height="300">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SubtitleFile">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Id}" />
                            <TextBlock Text="{x:Bind Name}"
                                       FontSize="10"
                                       Opacity="0.7" />
                            <TextBlock Foreground="{StaticResource AccentAAFillColorDefaultBrush}"
                                       FontSize="9"
                                       Opacity="0.8"
                                       Text="{x:Bind Description}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                FontSize="10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Tag="{Binding}"
                                Click="Subtitle_Button_Click">
                            <SymbolIcon Height="15"
                                        Width="15"
                                        Symbol="Download" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ProgressRing HorizontalAlignment="Center"
                      Visibility="Collapsed"
                      x:Name="PRing"
                      VerticalAlignment="Center" />
    </Grid>
</ContentDialog>
