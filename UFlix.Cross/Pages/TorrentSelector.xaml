<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="UFlix.Cross.Pages.TorrentSelector"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:UFlix.Cross.Pages"
               IsPrimaryButtonEnabled="True"
               DefaultButton="Primary"
               Title="Select Torrent"
               PrimaryButtonText="Select"
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d"
               MinWidth="450"
               Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">5,5,5,5</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">600</x:Double>
    </ContentDialog.Resources>
    <ComboBox MinWidth="400"
              x:Name="Selector" />
</ContentDialog>
