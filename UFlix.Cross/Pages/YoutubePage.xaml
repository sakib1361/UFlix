<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="UFlix.Cross.Pages.YoutubePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      xmlns:yt="using:UFlix.Engine.Services"
      xmlns:tm="using:UFlix.Cross.Templates"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <SolidColorBrush x:Key="YtThumbBrush"
                         Color="#FF1E191B" />
        <SolidColorBrush x:Key="YtBadgeBrush"
                         Color="#E6000000" />
        <SolidColorBrush x:Key="YtLiveBrush"
                         Color="#FFCC0000" />

        <!-- YouTube-style filter chip: a rounded pill, filled with the accent when checked -->
        <Style x:Key="ChipStyle"
               TargetType="RadioButton">
            <Setter Property="Margin"
                    Value="0,0,8,0" />
            <Setter Property="MinWidth"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root"
                              CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1">
                            <Border x:Name="Hover"
                                    Background="White"
                                    Opacity="0" />
                            <ContentPresenter x:Name="Text"
                                              Margin="12,5"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity"
                                                    Value="0.08" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity"
                                                    Value="0.14" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background"
                                                    Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="Root.BorderBrush"
                                                    Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="Text.Foreground"
                                                    Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="MinWidth"
                    Value="0" />
            <Setter Property="MinHeight"
                    Value="0" />
        </Style>

        <Style x:Key="CardContainerStyle"
               TargetType="GridViewItem">
            <Setter Property="Margin"
                    Value="4" />
            <Setter Property="Padding"
                    Value="6" />
            <Setter Property="CornerRadius"
                    Value="14" />
        </Style>

        <MenuFlyout x:Key="CardMenu">
            <MenuFlyoutItem Text="Play"
                            Click="MenuPlay_Click">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Go to channel"
                            Click="MenuChannel_Click">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Copy link"
                            Click="MenuCopy_Click">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Link" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Open on youtube.com"
                            Click="MenuBrowser_Click">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Globe" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header: back (channel view) · brand · search -->
        <Grid Padding="20,14,20,10"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Style="{StaticResource SubtleButton}"
                    Padding="8"
                    CornerRadius="18"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Back"
                    Click="Back_Click">
                <FontIcon Glyph="&#xE72B;"
                          FontSize="16" />
            </Button>
            <Button Grid.Column="1"
                    Style="{StaticResource SubtleButton}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Home"
                    Click="Home_Click">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Border Width="30"
                            Height="21"
                            CornerRadius="6"
                            Background="{StaticResource YtLiveBrush}">
                        <FontIcon Glyph="&#xE768;"
                                  FontSize="10"
                                  Foreground="White" />
                    </Border>
                    <TextBlock Text="YouTube"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="2"
                            MaxWidth="600"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            PlaceholderText="Search, or paste a YouTube link"
                            QueryIcon="Find"
                            ItemsSource="{x:Bind SearchSuggestions}"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- chips: topics on the home feed, result filters while searching -->
        <ScrollViewer Grid.Row="1"
                      Padding="20,0,20,10"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="TopicChips"
                            Orientation="Horizontal">
                    <RadioButton x:Name="ForYouChip"
                                 Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="For you"
                                 IsChecked="True"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="Music"
                                 Tag="music"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="Gaming"
                                 Tag="gaming"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="News"
                                 Tag="news today"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="Live"
                                 Tag="live now"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="Podcasts"
                                 Tag="podcast"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="Trailers"
                                 Tag="official trailer"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="Sports"
                                 Tag="sports highlights"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="Technology"
                                 Tag="technology"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="Science"
                                 Tag="science documentary"
                                 Checked="Topic_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Topics"
                                 Content="Cooking"
                                 Tag="cooking recipes"
                                 Checked="Topic_Checked" />
                </StackPanel>
                <StackPanel x:Name="FilterChips"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <RadioButton x:Name="AllChip"
                                 Style="{StaticResource ChipStyle}"
                                 GroupName="Filters"
                                 Content="All"
                                 Tag="None"
                                 IsChecked="True"
                                 Checked="Filter_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Filters"
                                 Content="Videos"
                                 Tag="Video"
                                 Checked="Filter_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Filters"
                                 Content="Playlists"
                                 Tag="Playlist"
                                 Checked="Filter_Checked" />
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 GroupName="Filters"
                                 Content="Channels"
                                 Tag="Channel"
                                 Checked="Filter_Checked" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <GridView x:Name="ResultsGrid"
                  Grid.Row="2"
                  Padding="14,0,14,24"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemContainerStyle="{StaticResource CardContainerStyle}"
                  ItemsSource="{x:Bind Items}"
                  ItemClick="Card_ItemClick"
                  Loaded="ResultsGrid_Loaded">
            <GridView.Header>
                <StackPanel Padding="6,0,6,0"
                            Spacing="6">
                    <!-- channel view -->
                    <Grid x:Name="ChannelHeader"
                          Visibility="Collapsed"
                          ColumnSpacing="20"
                          Margin="0,6,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="96"
                                Height="96"
                                CornerRadius="48"
                                Background="{StaticResource YtThumbBrush}">
                            <tm:CustomImage x:Name="ChannelAvatar"
                                            DecodeWidth="96"
                                            Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock x:Name="ChannelTitle"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Latest uploads"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- home: continue watching -->
                    <StackPanel x:Name="ContinuePanel"
                                Visibility="Collapsed"
                                Spacing="8"
                                Margin="0,0,0,10">
                        <TextBlock Text="Continue watching"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <ListView x:Name="ContinueList"
                                  Height="200"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="Card_ItemClick"
                                  ItemsSource="{x:Bind ContinueItems}"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding"
                                            Value="6" />
                                    <Setter Property="Margin"
                                            Value="0,0,6,0" />
                                    <Setter Property="CornerRadius"
                                            Value="12" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="yt:YtItem">
                                    <StackPanel Width="240"
                                                Spacing="6"
                                                RightTapped="Card_RightTapped">
                                        <Grid Height="135"
                                              CornerRadius="10"
                                              Background="{StaticResource YtThumbBrush}">
                                            <tm:CustomImage DecodeWidth="240"
                                                            Stretch="UniformToFill"
                                                            Source="{x:Bind Thumbnail}" />
                                            <Border Background="{StaticResource YtBadgeBrush}"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="6,6,6,10"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom">
                                                <TextBlock Text="{x:Bind Badge}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="White" />
                                            </Border>
                                            <ProgressBar VerticalAlignment="Bottom"
                                                         Maximum="100"
                                                         MinHeight="4"
                                                         Height="4"
                                                         CornerRadius="0"
                                                         Foreground="{StaticResource YtLiveBrush}"
                                                         Background="#80FFFFFF"
                                                         Value="{x:Bind ProgressPercent}"
                                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Author}"
                                                   FontSize="12"
                                                   Margin="0,-4,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- home: recent searches -->
                    <StackPanel x:Name="HistoryPanel"
                                Visibility="Collapsed"
                                Spacing="8"
                                Margin="0,0,0,10">
                        <TextBlock Text="Recent searches"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <ScrollViewer HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind History}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid CornerRadius="16"
                                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                              BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SubtleButton}"
                                                        Padding="12,5,6,5"
                                                        Tag="{Binding}"
                                                        Click="History_Click">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="8">
                                                        <FontIcon Glyph="&#xE81C;"
                                                                  FontSize="12"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="13" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SubtleButton}"
                                                        Padding="6,5,10,5"
                                                        Tag="{Binding}"
                                                        ToolTipService.ToolTip="Remove"
                                                        Click="HistoryRemove_Click">
                                                    <FontIcon Glyph="&#xE711;"
                                                              FontSize="10"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <TextBlock x:Name="SectionTitle"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4" />
                </StackPanel>
            </GridView.Header>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="yt:YtItem">
                    <Grid Width="304"
                          RightTapped="Card_RightTapped">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="171" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- video / playlist: 16:9 thumbnail with a duration or playlist badge -->
                        <Grid CornerRadius="12"
                              Background="{StaticResource YtThumbBrush}"
                              Visibility="{Binding Kind, Converter={StaticResource ParamConverter}, ConverterParameter=Video}">
                            <tm:CustomImage DecodeWidth="304"
                                            Stretch="UniformToFill"
                                            Source="{x:Bind Thumbnail}" />
                            <Border Background="{StaticResource YtBadgeBrush}"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Margin="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding IsLive, Converter={StaticResource ParamConverter}, ConverterParameter=False}">
                                <TextBlock Text="{x:Bind Badge}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                            <Border Background="{StaticResource YtLiveBrush}"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Margin="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding IsLive, Converter={StaticResource BoolVisibilityConverter}}">
                                <TextBlock Text="LIVE"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                        </Grid>
                        <Grid CornerRadius="12"
                              Background="{StaticResource YtThumbBrush}"
                              Visibility="{Binding Kind, Converter={StaticResource ParamConverter}, ConverterParameter=Playlist}">
                            <tm:CustomImage DecodeWidth="304"
                                            Stretch="UniformToFill"
                                            Source="{x:Bind Thumbnail}" />
                            <Border Background="{StaticResource YtBadgeBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE8FD;"
                                              FontSize="12"
                                              Foreground="White" />
                                    <TextBlock Text="Playlist"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- channel: round avatar -->
                        <Border Width="136"
                                Height="136"
                                CornerRadius="68"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource YtThumbBrush}"
                                Visibility="{Binding Kind, Converter={StaticResource ParamConverter}, ConverterParameter=Channel}">
                            <tm:CustomImage DecodeWidth="136"
                                            Stretch="UniformToFill"
                                            Source="{x:Bind Thumbnail}" />
                        </Border>

                        <Grid Grid.Row="1"
                              Margin="2,10,0,4"
                              ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           MaxLines="2"
                                           Height="40"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Style="{StaticResource SubtleButton}"
                                        HorizontalAlignment="Left"
                                        ToolTipService.ToolTip="Go to channel"
                                        Click="Author_Click">
                                    <TextBlock Text="{x:Bind Author}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SubtleButton}"
                                    Padding="6"
                                    CornerRadius="16"
                                    VerticalAlignment="Top"
                                    ToolTipService.ToolTip="More"
                                    Click="More_Click">
                                <FontIcon Glyph="&#xE712;"
                                          FontSize="14" />
                            </Button>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.Footer>
                <ProgressRing x:Name="MoreRing"
                              IsActive="False"
                              Width="28"
                              Height="28"
                              Margin="0,16" />
            </GridView.Footer>
        </GridView>

        <ProgressRing x:Name="LoadingRing"
                      Grid.Row="2"
                      IsActive="False"
                      Width="48"
                      Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        <StackPanel x:Name="EmptyState"
                    Grid.Row="2"
                    Spacing="10"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <FontIcon Glyph="&#xE721;"
                      FontSize="40"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyText"
                       Text="Nothing found."
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
