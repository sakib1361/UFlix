<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="UFlix.Cross.Pages.LibraryMovieDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:UFlix.Cross.Pages"
               Loaded="Content_Loaded"
               xmlns:models="using:UFlix.Engine.Models"
               xmlns:tm="using:UFlix.Cross.Templates"
               xmlns:tmdb="using:TMDbLib.Objects.Movies"
               Width="900"
               Height="600"
               MaxWidth="2000"
               MaxHeight="2000"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d">
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">5,5,5,5</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">600</x:Double>
    </ContentDialog.Resources>
    <Grid Width="1200"
          Height="600">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="150" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <tm:CustomImage Source="{x:Bind CurrentMovie.BackdropPath}"
                        IsTMDB="True"
                        Stretch="Fill"
                        Grid.ColumnSpan="2"
                        Grid.RowSpan="2"
                        Opacity="0.2" />
        <StackPanel Grid.RowSpan="2">
            <tm:CustomImage DecodeWidth="250"
                            Source="{x:Bind CurrentMovie.PosterPath}"
                            IsTMDB="True" />
            <Grid>
                <StackPanel Orientation="Horizontal">
                   
                    <RatingControl MaxRating="5"
                                   Margin="0,5,5,0"
                                   IsReadOnly="True"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Value="{x:Bind CustomRating}" />
                    <TextBlock Text="{x:Bind CurrentMovie.VoteAverage}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
                
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{x:Bind CurrentMovie.ReleaseDate.Value.Year}" />
            </Grid>
            <ToggleButton x:Name="CastButton"
                          Content="Cast"
                          Margin="0,5,0,0"
                          IsChecked="False" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Margin="10,0"
                    Grid.Row="0">
            <TextBlock Text="{x:Bind CurrentMovie.Title}"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind CurrentMovie.Overview}"
                       MaxLines="10"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Left"
                       LineStackingStrategy="MaxHeight"
                       Width="800" />
            <Button x:Name="ContinueButton"
                    Margin="0,20"
                    Click="ContinueButton_Click"
                    Content="Continue Watching"/>
            
        </StackPanel>
        <AppBarButton Icon="Cancel"
                      IsCompact="True"
                      Grid.Column="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Click="Close_Click" />
        <ProgressBar x:Name="LoadIndicator"
                     IsIndeterminate="True"
                     Grid.Column="1"
                     Grid.Row="1"
                     VerticalAlignment="Top"
                     Visibility="Collapsed"
                     HorizontalAlignment="Stretch" />
        <GridView Grid.Column="1"
                  Grid.Row="1"
                  Padding="15,0,0,0"
                  Visibility="{Binding ElementName=CastButton, Path=IsChecked, Converter={StaticResource ParamConverter}, ConverterParameter=True}"
                  ItemsSource="{x:Bind CurrentMovie.Credits.Cast}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="tmdb:Cast">
                    <StackPanel Margin="3">
                        <tm:CustomImage DecodeWidth="150"
                                        IsTMDB="True"
                                        Source="{x:Bind ProfilePath}"
                                        Height="200" />
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock Text="{x:Bind Character}"
                                   FontSize="11"
                                   MaxWidth="150"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <Grid Grid.Column="1"
              Grid.Row="1"
              Visibility="{Binding ElementName=CastButton, Path=IsChecked, Converter={StaticResource ParamConverter}, ConverterParameter=False}">
            <tm:TorrentQualityView x:Name="TorrentView"
                                   Padding="0,0,5,0"
                                   HeaderMargin="0,5,330,5"
                                   TorrentSelected="TorrentView_TorrentSelected" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,5,30,5"
                        Grid.Column="1"
                        Grid.Row="1">
                <ComboBox x:Name="ProviderCombo"
                          SelectionChanged="ProviderCombo_SelectionChanged"
                          DisplayMemberPath="Name"
                          MinWidth="180" />
                <Button x:Name="ForceButton"
                        Margin="5,0"
                        Click="ForceButton_Click">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <Button x:Name="CustomButtom">
                    <SymbolIcon Symbol="Download" />
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel>
                                <TextBox x:Name="CustomFileText"
                                         Width="300"
                                         PlaceholderText="Paste Uri or Filepath" />
                                <Button HorizontalAlignment="Center"
                                        Content="Open"
                                        Click="CustomOpen_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
      
        
    </Grid>
</ContentDialog>
