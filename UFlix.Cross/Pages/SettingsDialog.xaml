<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="UFlix.Cross.Pages.SettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d"
               Title="Settings"
               CloseButtonText="Close"
               Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">5,5,5,5</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">2000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">2000</x:Double>
        <x:Double x:Key="PivotHeaderItemFontSize">18</x:Double>
    </ContentDialog.Resources>
    <Pivot Width="420"
           Height="420">
        <PivotItem Header="Player">
            <ScrollViewer>
                <StackPanel Spacing="5"
                            Margin="0,10">
                    <ComboBox ItemsSource="{x:Bind SubtitleProviders}"
                              Header="Subtitle provider"
                              HorizontalAlignment="Stretch"
                              SelectedItem="{x:Bind Settings.SubtitleProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox Header="Subtitle font size"
                               Minimum="10"
                               Maximum="120"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind Player.SubtitleFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Subtitle font"
                             PlaceholderText="Default"
                             Text="{x:Bind Player.SubtitleFont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Subtitle colour (#AARRGGBB)"
                             Text="{x:Bind Player.SubtitleColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
        <PivotItem Header="Downloads">
            <ScrollViewer>
                <StackPanel Spacing="5"
                            Margin="0,10">
                    <TextBox Header="Torrent folder"
                             Text="{x:Bind Settings.TorrentDownloadPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Default download folder" />
                    <TextBox Header="Max torrent folder size (GB, 0 = no limit)"
                             Text="{x:Bind Settings.MaxFolderSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="0" />
                    <TextBox Header="YouTube folder"
                             Text="{x:Bind Settings.YoutubeDownloadPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Default download folder" />
                    <CheckBox Content="Use YTDL first for YouTube"
                              IsChecked="{x:Bind Settings.UseYtDLFirst, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
        <PivotItem Header="Torrents">
            <ScrollViewer>
                <ItemsRepeater Margin="0,10"
                               ItemsSource="{x:Bind CurrentEngines}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <TextBox Margin="0,2.5"
                                     Header="{Binding Name}"
                                     Text="{Binding DefaultUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{Binding Name}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </PivotItem>
        <PivotItem Header="Updates">
            <StackPanel Spacing="10"
                        Margin="0,10">
                <TextBlock x:Name="VersionText"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <CheckBox x:Name="AutoCheckBox"
                          Content="Check for updates daily"
                          IsChecked="{x:Bind Updates.AutoCheck, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="CheckButton"
                            Content="Check now"
                            Click="CheckButton_Click" />
                    <Button x:Name="InstallButton"
                            Content="Install and restart"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="Collapsed"
                            Click="InstallButton_Click" />
                </StackPanel>
                <ProgressBar x:Name="UpdateProgress"
                             Maximum="100"
                             Visibility="Collapsed" />
                <TextBlock x:Name="UpdateStatus"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton x:Name="ReleasesLink"
                                 Content="Open the releases page"
                                 Padding="0"
                                 Visibility="Collapsed" />
            </StackPanel>
        </PivotItem>
    </Pivot>
</ContentDialog>
