<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="UFlix.Cross.Pages.TvPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UFlix.Cross.Pages"
      xmlns:models="using:UFlix.Engine.Models"
      xmlns:tm="using:UFlix.Cross.Templates"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <GridView IsItemClickEnabled="True"
              ItemClick="GridView_ItemClick"
              ItemsSource="{x:Bind AllItems}">
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="models:MediaItem">
                <StackPanel HorizontalAlignment="Center"
                            Margin="15"
                            Height="160"
                            Width="220">
                    <tm:CustomImage DecodeWidth="220"
                                    Stretch="UniformToFill"
                                    Height="135"
                                    Source="{x:Bind Image}" />
                    <TextBlock Text="{x:Bind Title}"
                               MaxLines="2"
                               FontWeight="SemiBold"
                               FontSize="18"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</Page>
