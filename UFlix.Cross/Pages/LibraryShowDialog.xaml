<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="UFlix.Cross.Pages.LibraryShowDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d"
               xmlns:models="using:UFlix.Engine.Models"
               xmlns:tmdbSearch="using:TMDbLib.Objects.Search"
               xmlns:tmdbTv="using:TMDbLib.Objects.TvShows"
               xmlns:tm="using:UFlix.Cross.Templates"
               Loaded="ContentDialog_Loaded"
               Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">5,5,5,5</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">600</x:Double>
    </ContentDialog.Resources>
    <Grid Width="1200"
          Height="600"
          Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <tm:CustomImage Source="{x:Bind CurrentShow.BackdropPath}"
                            Grid.ColumnSpan="2"
                            Grid.RowSpan="2"
                            Opacity="0.2"
                            Stretch="UniformToFill"
                            IsTMDB="True" />
            <tm:CustomImage DecodeWidth="160"
                            Source="{x:Bind CurrentShow.PosterPath}"
                            Grid.RowSpan="2"
                            Height="200"
                            IsTMDB="True" />
            <StackPanel Grid.Column="1"
                        Margin="10">
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Text="{x:Bind CurrentShow.Name}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Bind CurrentShow.FirstAirDate.Value.Year}"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="10,0"
                               VerticalAlignment="Center"
                               Text="{x:Bind CurrentGenre}" />
                    <RatingControl MaxRating="5"
                                   Margin="10,0"
                                   IsReadOnly="True"
                                   VerticalAlignment="Center"
                                   Value="{x:Bind CurrentRating}" />
                </StackPanel>
                <TextBlock Text="{x:Bind CurrentShow.Overview}"
                           Padding="0,10,10,10"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Grid.Column="1"
                        Grid.Row="1"
                        Margin="10,3">
                <Button x:Name="ContinueButton"
                        Click="ContinueButton_Click"
                        Margin="0,0,20,0"
                        Visibility="Collapsed" />
                <ComboBox DisplayMemberPath="Name"
                          SelectedIndex="0"
                          x:Name="SeasonCombo"
                          SelectionChanged="ComboBox_SelectionChanged"
                          ItemsSource="{x:Bind CurrentShow.Seasons}" />
                <ComboBox x:Name="ProviderCombo"
                          HorizontalAlignment="Right"
                          Margin="10,0"
                          SelectionChanged="ProviderCombo_SelectionChanged"
                          DisplayMemberPath="Name"
                          MinWidth="180" />
                <Button x:Name="FullSeason"
                        Click="FullSeason_Click">
                    <SymbolIcon Symbol="SelectAll" />
                </Button>
                <ToggleButton x:Name="CastButton"
                              Content="Cast"
                              Margin="10,0,0,0"
                              IsChecked="False"
                              Checked="CastButton_Checked" />
            </StackPanel>
        </Grid>
        <AppBarButton Icon="Cancel"
                      IsCompact="True"
                      Grid.Column="2"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Click="Close_Click" />
        <GridView x:Name="CastGrid"
                  Grid.Row="1"
                  Margin="0,10,0,0"
                  Padding="15,0,0,0"
                  Visibility="{Binding ElementName=CastButton, Path=IsChecked, Converter={StaticResource ParamConverter}, ConverterParameter=True}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="tmdbTv:Cast">
                    <StackPanel Margin="3">
                        <tm:CustomImage DecodeWidth="150"
                                        IsTMDB="True"
                                        Source="{x:Bind ProfilePath}"
                                        Height="200" />
                        <TextBlock Text="{x:Bind Name}" />
                        <TextBlock Text="{x:Bind Character}"
                                   FontSize="11"
                                   MaxWidth="150"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <Grid Grid.Row="1"
              Margin="0,10,0,0"
              Visibility="{Binding ElementName=CastButton, Path=IsChecked, Converter={StaticResource ParamConverter}, ConverterParameter=False}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ListView ItemsSource="{x:Bind TvEpisodes}"
                      x:Name="EpisodeList"
                      Padding="0,0,0,20"
                      SelectionChanged="ListView_SelectionChanged"
                      Grid.Row="1">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="tmdbSearch:TvSeasonEpisode">
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <tm:CustomImage DecodeWidth="120"
                                            IsTMDB="True"
                                            Source="{x:Bind StillPath}" />
                            <StackPanel Grid.Column="1"
                                        Margin="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EP."
                                               FontSize="18" />
                                    <TextBlock Text="{x:Bind EpisodeNumber}"
                                               FontSize="18"
                                               Margin="0,0,10,0" />
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="18" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Overview}"
                                           MaxLines="3"
                                           Foreground="LightGray"
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <TextBlock Text="{x:Bind AirDate.Value.Date.ToShortDateString()}" />
                                    <TextBlock Text="{x:Bind VoteAverage}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressBar x:Name="LoadIndicator"
                         IsIndeterminate="True"
                         Grid.Column="1"
                         VerticalAlignment="Top"
                         Visibility="Collapsed"
                         HorizontalAlignment="Stretch" />
            <tm:TorrentQualityView x:Name="TorrentView"
                                   Grid.Column="1"
                                   Margin="0,0,10,0"
                                   HeaderMargin="0,0,100,5"
                                   TorrentSelected="TorrentView_TorrentSelected" />
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Grid.Column="1">
                <AppBarButton x:Name="ForceButton"
                              IsCompact="True"
                              Padding="5"
                              Icon="Refresh"
                              Click="ForceButton_Click" />
                <AppBarButton Icon="Download"
                              IsCompact="True"
                              x:Name="CustomUriButton">
                    <AppBarButton.Flyout>
                        <Flyout>
                            <StackPanel Width="200">
                                <TextBlock Text="Open Custom Link" />
                                <TextBox x:Name="CustomTextBox" />
                                <Button Content="Ok"
                                        Click="CustomUriButton_Click"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
