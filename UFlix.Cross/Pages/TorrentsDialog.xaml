<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="UFlix.Cross.Pages.TorrentsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d"
               Title="Torrents"
               xmlns:services="using:UFlix.Cross.Services"
               xmlns:models="using:UFlix.Engine.Models"
               CloseButtonText="Close"
               Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">2000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">2000</x:Double>
    </ContentDialog.Resources>
    <Pivot Width="900"
           Height="600">
        <PivotItem Header="Downloading">
            <Grid>
                <TextBlock x:Name="EmptyText"
                           Text="No torrents in the session"
                           Opacity="0.7"
                           Margin="0,20"
                           HorizontalAlignment="Center" />
                <ListView SelectionMode="None"
                          ItemsSource="{x:Bind Items}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:TorrentItem">
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar Grid.Row="1"
                                             Margin="0,6"
                                             Maximum="100"
                                             Value="{x:Bind Progress, Mode=OneWay}" />
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Border Background="Maroon"
                                            CornerRadius="3"
                                            Padding="5,0">
                                        <TextBlock Text="{x:Bind Kind, Mode=OneWay}"
                                                   FontSize="11" />
                                    </Border>
                                    <TextBlock FontSize="12"
                                               Opacity="0.8">
                                        <Run Text="{x:Bind State, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{x:Bind Progress, Mode=OneWay}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Row="3"
                                           FontSize="11"
                                           Opacity="0.7"
                                           Text="{x:Bind Details, Mode=OneWay}" />
                                <Button Grid.Column="1"
                                        Grid.RowSpan="4"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        Click="Pause_Click"
                                        Background="Transparent"
                                        BorderBrush="Transparent">
                                    <Grid>
                                        <SymbolIcon Symbol="Pause"
                                                    Visibility="{x:Bind IsPaused, Mode=OneWay, Converter={StaticResource ParamConverter}, ConverterParameter=False}" />
                                        <SymbolIcon Symbol="Play"
                                                    Visibility="{x:Bind IsPaused, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2"
                                        Grid.RowSpan="4"
                                        VerticalAlignment="Center"
                                        Click="Remove_Click"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="Maroon">
                                    <SymbolIcon Symbol="Delete" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </PivotItem>
        <PivotItem Header="Search">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="Movie name"
                             KeyDown="SearchBox_KeyDown" />
                    <ComboBox x:Name="ProviderCombo"
                              Grid.Column="1"
                              DisplayMemberPath="Name"
                              MinWidth="180" />
                    <Button Grid.Column="2"
                            Click="Search_Click"
                            Background="Maroon">
                        <SymbolIcon Symbol="Find" />
                    </Button>
                </Grid>
                <ProgressBar x:Name="LoadIndicator"
                             Grid.Row="1"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
                <TextBlock x:Name="SearchEmptyText"
                           Grid.Row="2"
                           Text="Search a movie by name"
                           Opacity="0.7"
                           Margin="0,20"
                           HorizontalAlignment="Center" />
                <ListView Grid.Row="2"
                          SelectionMode="None"
                          ItemsSource="{x:Bind Results}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TorrentInfo">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <Border Background="Maroon"
                                                CornerRadius="3"
                                                Padding="5,0">
                                            <TextBlock Text="{x:Bind Quality}"
                                                       FontSize="11" />
                                        </Border>
                                        <TextBlock Opacity="0.7"
                                                   FontSize="12"
                                                   Text="{x:Bind Description}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        ToolTipService.ToolTip="Play"
                                        Click="PlayResult_Click"
                                        Background="Transparent"
                                        BorderBrush="Transparent">
                                    <SymbolIcon Symbol="Play" />
                                </Button>
                                <Button Grid.Column="2"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Download"
                                        Click="DownloadResult_Click"
                                        Background="Transparent"
                                        BorderBrush="Transparent">
                                    <SymbolIcon Symbol="Download" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </PivotItem>
    </Pivot>
</ContentDialog>
