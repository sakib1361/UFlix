<Project Sdk="Uno.Sdk/6.7.30">
	<PropertyGroup>
		<!-- the WinAppSDK head needs the Windows SDK tooling, so it is only built on Windows hosts -->
		<TargetFrameworks>net10.0-desktop</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.26100;$(TargetFrameworks)</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>
		<UnoFeatures>Skia</UnoFeatures>
		<RootNamespace>UFlix.Cross</RootNamespace>
		<ApplicationTitle>UFlix</ApplicationTitle>
		<ApplicationId>com.uflix.cross</ApplicationId>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<InvariantGlobalization>true</InvariantGlobalization>
		<DefaultItemExcludes>$(DefaultItemExcludes);out\**;out-*\**</DefaultItemExcludes>
	</PropertyGroup>

	<!-- Uno turns the version attributes off, so the version (VERSION file / -p:Version) is stamped here for Settings → Updates.
	     Update feed: the GitHub repo whose releases the app checks (CI sets UFlixUpdateRepo; local builds have none, so no checks). -->
	<ItemGroup>
		<AssemblyMetadata Include="UFlixVersion" Value="$(Version)" />
		<AssemblyMetadata Include="UFlixUpdateRepo" Value="$(UFlixUpdateRepo)" Condition="'$(UFlixUpdateRepo)' != ''" />
	</ItemGroup>

	<!-- WinAppSDK head = real WinUI 3: unpackaged and self-contained until packaging is decided.
	     MSIX tooling stays on: it generates resources.pri without Visual Studio (no .pri = crash at startup). -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-windows10'))">
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<EnableMsixTooling>true</EnableMsixTooling>
		<DefaultLanguage>en-US</DefaultLanguage>
		<Platforms>x64</Platforms>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\uflix.ico</ApplicationIcon>
		<!-- Platforms/Windows/Program.cs: Velopack's hook must run before WinUI starts -->
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<!-- Uno always names a default publish profile (win-$(Platform).pubxml); there is none, package-windows.ps1 passes every
		     publish setting itself, so the "profile not found" warning (NETSDK1198) is only noise -->
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);NETSDK1198</MSBuildWarningsAsMessages>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="YoutubeDLSharp" Version="1.2.0" />
		<!-- installer + updates (Platforms/*/package-*); MIT -->
		<PackageReference Include="Velopack" Version="1.2.161" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Engines\MpvSharp\MpvSharp.csproj" />
		<ProjectReference Include="..\Engines\NativeRunner\NativeRunner.csproj" />
		<ProjectReference Include="..\Engines\UFlix.Engine\UFlix.Engine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="UFlix.Engine.Services" />
		<Using Include="UFlix.Engine.Torrents" />
	</ItemGroup>

	<!-- native assets for one RID only: the publish RID, else the head/host OS (properties are evaluated before items) -->
	<PropertyGroup>
		<NativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NativeRid>
		<NativeRid Condition="'$(NativeRid)' == '' and ($(TargetFramework.Contains('-windows')) or $([MSBuild]::IsOSPlatform('windows')))">win-x64</NativeRid>
		<NativeRid Condition="'$(NativeRid)' == ''">linux-x64</NativeRid>
	</PropertyGroup>

	<!-- bundled libmpv (Native/mpv/), never the system copy -->
	<ItemGroup>
		<None Include="runtimes\win-x64\native\*.dll" CopyToOutputDirectory="PreserveNewest" Condition="'$(NativeRid)' == 'win-x64'" />
		<None Include="runtimes\linux-x64\native\*.so*" CopyToOutputDirectory="PreserveNewest" Condition="'$(NativeRid)' == 'linux-x64'" />
	</ItemGroup>

	<!-- window icon on the X11 head (the X11 default otherwise) -->
	<ItemGroup Condition="!$(TargetFramework.Contains('-windows10'))">
		<None Include="Assets\uflix.png" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
