<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="UFlix.Cross.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tm="using:UFlix.Cross.Templates"
             RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#FF9B1C2E</Color>
            <Color x:Key="SystemAccentColorLight1">#FFB8323F</Color>
            <Color x:Key="SystemAccentColorLight2">#FFD2535E</Color>
            <Color x:Key="SystemAccentColorLight3">#FFE9848C</Color>
            <Color x:Key="SystemAccentColorDark1">#FF7F1424</Color>
            <Color x:Key="SystemAccentColorDark2">#FF640E1B</Color>
            <Color x:Key="SystemAccentColorDark3">#FF4A0913</Color>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected"
                             Color="#FF3A0A12" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"
                             Color="#FF4A0913" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"
                             Color="#FF2E070E" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected"
                             Color="#FF3A0A12" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver"
                             Color="#FF4A0913" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed"
                             Color="#FF2E070E" />
            <SolidColorBrush x:Key="PlayerBarBrush"
                             Color="#FF141012" />
            <tm:ParameterVisibiliyConverter x:Key="ParamConverter" />
            <tm:BoolVisibiliyConverter x:Key="BoolVisibilityConverter" />
            <Style x:Key="FlowTable"
                   TargetType="StackPanel">
                <Setter Property="Background"
                        Value="{StaticResource PlayerBarBrush}" />
                <Setter Property="Width"
                        Value="320" />
                <Setter Property="VerticalAlignment"
                        Value="Top" />
                <Setter Property="HorizontalAlignment"
                        Value="Left" />
            </Style>
            <Style x:Key="TextHeader"
                   TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="Courier New" />
                <Setter Property="FontSize"
                        Value="20" />
                <Setter Property="Foreground"
                        Value="{StaticResource AccentAAFillColorTertiaryBrush}" />
                <Setter Property="TextAlignment"
                        Value="Center" />
                <Setter Property="TextDecorations"
                        Value="Underline" />
                <Setter Property="Margin"
                        Value="0 5 0 10" />
            </Style>
            <Style x:Key="TextInfo"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="16" />
                <Setter Property="Width"
                        Value="160" />
                <Setter Property="Foreground"
                        Value="{StaticResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Margin"
                        Value="10 0 0 0" />
            </Style>
            <Style x:Key="DarkTextInfo"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="16" />
                <Setter Property="Width"
                        Value="160" />
                <Setter Property="Foreground"
                        Value="White" />
                <Setter Property="Margin"
                        Value="10 0 0 0" />
            </Style>
            <Style x:Key="TextValue"
                   TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="Courier New" />
                <Setter Property="FontSize"
                        Value="16" />
                <Setter Property="Foreground"
                        Value="{StaticResource AccentFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="MaxHeight"
                        Value="92" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
