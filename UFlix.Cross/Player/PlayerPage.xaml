<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="UFlix.Cross.Player.PlayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UFlix.Cross.Player"
             xmlns:ctl="using:UFlix.Cross.Controls"
             xmlns:tm="using:UFlix.Cross.Templates"
             xmlns:models="using:UFlix.Engine.Models"
             KeyboardAcceleratorPlacementMode="Hidden"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape"
                             Invoked="ESC_Invoked"
                             Modifiers="None" />
        <KeyboardAccelerator Key="F"
                             Invoked="Fullscreen_Invoked"
                             Modifiers="None" />
        <KeyboardAccelerator Key="Space"
                             Invoked="Space_Invoked"
                             Modifiers="None" />
        <KeyboardAccelerator Key="Right"
                             Invoked="Right_Invoked"
                             Modifiers="None" />
        <KeyboardAccelerator Key="Left"
                             Invoked="Left_Invoked"
                             Modifiers="None" />
        <KeyboardAccelerator Key="Up"
                             Invoked="Up_Invoked"
                             Modifiers="None" />
        <KeyboardAccelerator Key="Down"
                             Invoked="Down_Invoked"
                             Modifiers="None" />
        <KeyboardAccelerator Key="T"
                             Invoked="Theater_Invoked"
                             Modifiers="None" />
        <KeyboardAccelerator Key="Z"
                             Invoked="SuboffsetUp_Invoked"
                             Modifiers="None" />
        <KeyboardAccelerator Key="X"
                             Invoked="SuboffsetDown_Invoked"
                             Modifiers="None" />
    </UserControl.KeyboardAccelerators>
    <UserControl.Resources>
        <tm:SecondsToStringConverter x:Key="SecondsToTime" />
        <tm:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <tm:DurationBadgeConverter x:Key="DurationBadge" />
        <tm:NullVisibilityConverter x:Key="NullVisibility" />
        <SolidColorBrush x:Key="ThumbBrush"
                         Color="#FF1E191B" />
        <SolidColorBrush x:Key="CardBrush"
                         Color="#FF1F191B" />
        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#FFB5AEB0" />
    </UserControl.Resources>
    <!-- Overlays on the video must look right while opaque: on Linux the video is a native X11 window and XAML over it loses alpha. -->
    <Grid x:Name="RootGrid"
          Background="Black"
          PointerMoved="Root_PointerMoved"
          DoubleTapped="Root_DoubleTapped">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ctl:VideoSurface x:Name="Video"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
        <local:MediaInfoPanel x:Name="InfoPanel"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />
        <Border x:Name="BufferingPanel"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="30"
                Background="{StaticResource PlayerBarBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Width="320">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DarkTextInfo}"
                               Text="Download Rate" />
                    <TextBlock Style="{StaticResource DarkTextInfo}"
                               Text="{Binding DownloadRate}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DarkTextInfo}"
                               Text="Downloaded" />
                    <TextBlock Style="{StaticResource DarkTextInfo}"
                               Text="{Binding Downloaded}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DarkTextInfo}"
                               Text="Peers" />
                    <TextBlock Style="{StaticResource DarkTextInfo}"
                               Text="{Binding Peers}" />
                </StackPanel>
                <ProgressBar Maximum="100"
                             Height="20"
                             Margin="0,20,0,0"
                             Value="{Binding BufferProgress}" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="11"
                           Text="Buffering..." />
            </StackPanel>
        </Border>
        <Grid x:Name="ControllerPanel"
              Grid.Row="1"
              VerticalAlignment="Bottom"
              Padding="12,4,12,6"
              Background="{StaticResource PlayerBarBrush}">
            <Grid.Resources>
                <Style TargetType="AppBarButton"
                       BasedOn="{StaticResource AppBarButtonOverflowStyle}">
                    <Setter Property="IsCompact"
                            Value="True" />
                    <Setter Property="AllowFocusOnInteraction"
                            Value="False" />
                    <Setter Property="Width"
                            Value="40" />
                    <Setter Property="VerticalAlignment"
                            Value="Center" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding ElementName=MediaSlider, Path=Value, Converter={StaticResource SecondsToTime}}" />
                <Slider x:Name="MediaSlider"
                        Grid.Column="1"
                        AllowFocusOnInteraction="False"
                        Margin="10,0"
                        IsTabStop="False"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="MediaSlider_ValueChanged" />
                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Container"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <AppBarButton Icon="Play"
                                  Visibility="{Binding State, Converter={StaticResource ParamConverter}, ConverterParameter=Paused}"
                                  Command="{Binding PlayCommand}" />
                    <AppBarButton Icon="Pause"
                                  Visibility="{Binding State, Converter={StaticResource ParamConverter}, ConverterParameter=Playing}"
                                  Command="{Binding PauseCommand}" />
                    <AppBarButton x:Name="NextButton"
                                  Icon="Next"
                                  Visibility="Collapsed"
                                  Click="Next_Click" />
                    <AppBarButton x:Name="StopButton"
                                  Icon="Stop"
                                  Click="Stop_Click" />
                    <AppBarButton Icon="Video">
                        <AppBarButton.Flyout>
                            <MenuFlyout x:Name="FlyoutStreams">
                                <MenuFlyout.MenuFlyoutPresenterStyle>
                                    <Style TargetType="MenuFlyoutPresenter">
                                        <Setter Property="MaxHeight"
                                                Value="600" />
                                    </Style>
                                </MenuFlyout.MenuFlyoutPresenterStyle>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton x:Name="CaptionsButton"
                                  Visibility="Collapsed"
                                  ToolTipService.ToolTip="Captions">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7F0;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout x:Name="CaptionsFlyout">
                                <MenuFlyout.MenuFlyoutPresenterStyle>
                                    <Style TargetType="MenuFlyoutPresenter">
                                        <Setter Property="MaxHeight"
                                                Value="500" />
                                    </Style>
                                </MenuFlyout.MenuFlyoutPresenterStyle>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton ToolTipService.ToolTip="Playback speed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xEC4A;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout x:Name="SpeedFlyout"
                                        Opening="SpeedFlyout_Opening">
                                <ToggleMenuFlyoutItem Text="0.25x"
                                                      Tag="0.25"
                                                      Click="Speed_Click" />
                                <ToggleMenuFlyoutItem Text="0.5x"
                                                      Tag="0.5"
                                                      Click="Speed_Click" />
                                <ToggleMenuFlyoutItem Text="0.75x"
                                                      Tag="0.75"
                                                      Click="Speed_Click" />
                                <ToggleMenuFlyoutItem Text="Normal"
                                                      Tag="1"
                                                      Click="Speed_Click" />
                                <ToggleMenuFlyoutItem Text="1.25x"
                                                      Tag="1.25"
                                                      Click="Speed_Click" />
                                <ToggleMenuFlyoutItem Text="1.5x"
                                                      Tag="1.5"
                                                      Click="Speed_Click" />
                                <ToggleMenuFlyoutItem Text="1.75x"
                                                      Tag="1.75"
                                                      Click="Speed_Click" />
                                <ToggleMenuFlyoutItem Text="2x"
                                                      Tag="2"
                                                      Click="Speed_Click" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton Icon="View"
                                  ToolTipService.ToolTip="Stream info"
                                  Click="Info_Click" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="10,0">
                    <ProgressRing x:Name="ProgressIndicator"
                                  Width="24"
                                  Height="24"
                                  Margin="0,0,10,0"
                                  IsActive="False"
                                  IsIndeterminate="True" />
                    <TextBlock x:Name="TitleText"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel x:Name="VolumePanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <SymbolIcon Symbol="Volume"
                                Margin="0,0,8,0" />
                    <Slider IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            Maximum="150"
                            StepFrequency="5"
                            Width="110"
                            VerticalAlignment="Center"
                            Value="{Binding Volume, Mode=TwoWay}" />
                    <AppBarButton x:Name="TheaterButton"
                                  IsTabStop="False"
                                  Margin="10,0,0,0"
                                  Visibility="Collapsed"
                                  ToolTipService.ToolTip="Theater mode (T)"
                                  Click="Theater_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE89F;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="BtnFullScreen"
                                  IsTabStop="False"
                                  Icon="FullScreen"
                                  ToolTipService.ToolTip="Fullscreen (F)"
                                  Click="BtnFullScreen_Click" />
                </StackPanel>
            </Grid>
        </Grid>
        <!-- side panel: YouTube details + up next / playlist; never over the video -->
        <Grid x:Name="SidePanel"
              Grid.Column="1"
              Grid.RowSpan="2"
              Width="400"
              Background="{StaticResource PlayerBarBrush}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="DetailsPanel"
                        Padding="16,16,16,8"
                        Spacing="10"
                        Visibility="Collapsed">
                <TextBlock x:Name="DetailsTitle"
                           FontSize="18"
                           FontWeight="SemiBold"
                           MaxLines="3"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="{StaticResource ThumbBrush}">
                        <tm:CustomImage x:Name="DetailsAvatar"
                                        DecodeWidth="36"
                                        Stretch="UniformToFill" />
                    </Border>
                    <TextBlock x:Name="DetailsChannel"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="DetailsStats"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <ScrollViewer x:Name="DescriptionScroll"
                                      MaxHeight="72"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Hidden">
                            <TextBlock x:Name="DetailsDescription"
                                       FontSize="13"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </ScrollViewer>
                        <HyperlinkButton x:Name="MoreButton"
                                         Padding="0"
                                         Content="Show more"
                                         FontSize="13"
                                         Click="MoreDescription_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Grid Grid.Row="1"
                  Padding="16,8,12,4">
                <TextBlock x:Name="UpNextTitle"
                           Text="Up next"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,110,0" />
                <ToggleSwitch x:Name="AutoplaySwitch"
                              HorizontalAlignment="Right"
                              MinWidth="0"
                              OnContent="Autoplay"
                              OffContent="Autoplay"
                              Toggled="Autoplay_Toggled" />
            </Grid>
            <ListView x:Name="MediaList"
                      Grid.Row="2"
                      Padding="4,0,4,8"
                      SelectionChanged="MediaList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding"
                                Value="8,6" />
                        <Setter Property="Margin"
                                Value="0,1" />
                        <Setter Property="CornerRadius"
                                Value="10" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Height="90"
                                  CornerRadius="8"
                                  Background="{StaticResource ThumbBrush}">
                                <tm:CustomImage DecodeWidth="160"
                                                Stretch="UniformToFill"
                                                Source="{x:Bind Image}" />
                                <Border Background="#E6000000"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding Duration, Converter={StaticResource NullVisibility}}">
                                    <TextBlock Text="{Binding Duration, Converter={StaticResource DurationBadge}}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           MaxLines="2"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Author}"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
