<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AngleSharp" Version="1.5.2" />
		<PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
		<PackageReference Include="LiteDB" Version="5.0.21" />
		<PackageReference Include="TMDbLib" Version="3.0.0" />
		<PackageReference Include="YouTubeApiSharp" Version="0.0.5" />
		<PackageReference Include="YoutubeExplode" Version="6.6.0" />
	</ItemGroup>

	<!-- API keys: the git-ignored secrets.env at the repo root is compiled in (copy secrets.env.example to start). -->
	<PropertyGroup>
		<UFlixSecretsFile>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'secrets.env'))</UFlixSecretsFile>
	</PropertyGroup>
	<ItemGroup Condition="Exists('$(UFlixSecretsFile)')">
		<EmbeddedResource Include="$(UFlixSecretsFile)" LogicalName="UFlix.secrets.env" Link="secrets.env" />
	</ItemGroup>
	<Target Name="WarnMissingSecrets" BeforeTargets="CoreCompile" Condition="!Exists('$(UFlixSecretsFile)')">
		<Warning Text="secrets.env not found at the repo root: TMDB and OpenSubtitles will not work. Copy secrets.env.example to secrets.env and fill it in." />
	</Target>

</Project>
