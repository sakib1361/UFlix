// UFlix design tokens: dark surfaces, maroon/deep-red accent, card layouts.

export global Theme {
    // surfaces
    out property <color> bg: #111113;
    out property <color> sidebar: #0b0b0c;
    out property <color> surface: #1a1a1d;
    out property <color> surface-2: #232327;
    out property <color> surface-3: #2d2d32;
    out property <color> scrim: #000000b3;
    out property <color> border: #ffffff14;
    out property <color> border-strong: #ffffff29;
    // text
    out property <color> text: #f3f3f4;
    out property <color> text-2: #b4b4ba;
    out property <color> text-3: #7d7d85;
    // accent
    out property <color> accent: #d32f2f;
    out property <color> accent-hover: #e04848;
    out property <color> accent-deep: #8e1b1b;
    out property <color> accent-soft: #d32f2f33;
    out property <color> success: #43a047;
    out property <color> warning: #f9a825;
    // shape and space
    out property <length> radius-s: 6px;
    out property <length> radius: 10px;
    out property <length> radius-l: 16px;
    out property <length> gap-xs: 4px;
    out property <length> gap-s: 8px;
    out property <length> gap: 12px;
    out property <length> gap-m: 16px;
    out property <length> gap-l: 24px;
    out property <length> gap-xl: 32px;
    out property <length> page-padding: 32px;
    // type
    out property <length> font-display: 28px;
    out property <length> font-title: 20px;
    out property <length> font-subtitle: 16px;
    out property <length> font-body: 14px;
    out property <length> font-small: 12px;
    // cards
    out property <length> poster-width: 172px;
    out property <length> poster-height: 258px;
    out property <length> thumb-width: 296px;
    out property <length> thumb-height: 166px;
    // motion
    out property <duration> fast: 120ms;
    out property <duration> normal: 200ms;
}
