# Copy to secrets.env (git-ignored) and fill in. It is compiled into UFlix.Engine.dll at build time;
# an environment variable with the same name overrides a value at runtime.
UFLIX_TMDB_API_KEY=
UFLIX_OPENSUBTITLES_API_KEY=
UFLIX_OPENSUBTITLES_USERNAME=
UFLIX_OPENSUBTITLES_PASSWORD=

# Free key from a subdl.com account (API page in the account panel)
UFLIX_SUBDL_API_KEY=
